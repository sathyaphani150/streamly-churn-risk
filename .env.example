# ==============================================================================
# Streamly MLOps Environment Configuration Template
# DO NOT commit real secrets (.env) to version control.
# This file is an optional reference. The application does not require a .env
# file: committed defaults live in configs/environments/*.yaml, and deployment
# platforms can set these variables directly.
# ==============================================================================

# Runtime Environment: dev | ci | prod
STREAMLY_ENV=dev

# MLflow Tracking Configuration
# Local SQLite backend store and local artifacts directory for dev
MLFLOW_TRACKING_URI=sqlite:///mlruns.db
MLFLOW_EXPERIMENT_NAME=streamly-churn-risk

# Model Registry Target Alias (e.g., champion, production, challenger)
MODEL_REGISTRY_ALIAS=champion
MODEL_NAME=streamly_churn_model
MODEL_ARTIFACT_PATH=models/baseline_model.joblib
ALLOW_LOCAL_MODEL_FALLBACK=true

# Serving API Settings
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
